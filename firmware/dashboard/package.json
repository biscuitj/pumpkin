{
  "name": "pumpkin-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pumpkin clock web dashboard, built into one file and embedded in the firmware",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --mode setup",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
